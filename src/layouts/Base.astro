---
import '../styles/global.css';
import { site, pathTo } from '../lib/site';
interface Props { title?: string; description?: string; active?: 'posts' | 'tags'; noindex?: boolean; article?: boolean; }
const { title, description = site.description, active = 'posts', noindex = false, article = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = Astro.site && Astro.site.hostname !== 'localhost' ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F9FC" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="ko_KR" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={pathTo('rss.xml')} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('kimdongui-theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#171D29' : '#F7F9FC');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={pathTo()} aria-label="Kimdongui 블로그 홈"><span class="brand-mark" aria-hidden="true"></span>Kimdongui<span class="wordmark-period">.</span></a>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="다크 모드로 전환" aria-pressed="false">
          <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.8 13.1A9 9 0 0 1 10.9 3.2a9 9 0 1 0 9.9 9.9Z" /></svg>
          <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <span class="theme-label">다크 모드</span>
        </button>
      </div>
    </header>
    <main id="main" class:list={[article ? 'article-main' : 'main-column']}>
      {!article && <>
        <div class="intro"><p class="eyebrow">{site.eyebrow}</p><h1>{site.title}</h1>{site.subtitle && <p class="subtitle">{site.subtitle}</p>}</div>
        <nav class="main-nav" aria-label="블로그 메뉴"><a href={pathTo()} aria-current={active === 'posts' ? 'page' : undefined}>글 목록</a><a href={pathTo('tags/')} aria-current={active === 'tags' ? 'page' : undefined}>태그</a></nav>
      </>}
      <slot />
    </main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} Kimdongui</span><a href={pathTo('rss.xml')}>RSS</a></footer>
    <script>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle')!;
      const preference = window.matchMedia('(prefers-color-scheme: dark)');
      function updateTheme(theme: string) {
        root.dataset.theme = theme;
        const dark = theme === 'dark';
        button.setAttribute('aria-pressed', String(dark));
        button.setAttribute('aria-label', dark ? '라이트 모드로 전환' : '다크 모드로 전환');
        button.querySelector('.theme-label')!.textContent = dark ? '라이트 모드' : '다크 모드';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#171D29' : '#F7F9FC');
      }
      updateTheme(root.dataset.theme || 'light');
      button.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        updateTheme(next);
        try { localStorage.setItem('kimdongui-theme', next); } catch {}
      });
      preference.addEventListener('change', event => {
        let saved: string | null = null;
        try { saved = localStorage.getItem('kimdongui-theme'); } catch {}
        if (!saved) updateTheme(event.matches ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
